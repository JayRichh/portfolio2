{
  "name": "portfolio2",
  "version": "1.0.0",
  "description": "Modern Angular portfolio application with standalone components and signals",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "npm run generate:github && npm run generate:sitemap",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "server": "tsx server/index.ts",
    "dev": "concurrently \"npm start\" \"npm run server\"",
    "generate:sitemap": "tsx scripts/generate-sitemap.ts",
    "generate:github": "tsx scripts/generate-github-snapshot.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JayRichh/portfolio2.git"
  },
  "keywords": [
    "angular",
    "portfolio",
    "typescript",
    "ssr",
    "full-stack"
  ],
  "author": "Jayden Richardson <jayrich.dev@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/JayRichh/portfolio2/issues"
  },
  "homepage": "https://jayrich.dev",
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/platform-server": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/ssr": "^22.2.4",
    "@types/cors": "^2.8.19",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.6",
    "axios": "^1.13.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "d3": "^7.9.0",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-transition": "^3.0.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.4.0",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@types/node": "^25.6.0",
    "@vercel/node": "^5.5.28",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "istanbul-lib-instrument": "^6.0.3",
    "postcss": "^8.5.6",
    "sitemap": "^9.0.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  }
}
